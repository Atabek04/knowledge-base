filters:
  and:
    - file.inFolder("06-Planning/Trackers/LeetCode-Log")
    - file.name != "README"
properties:
  file.name:
    displayName: Problem
  note.difficulty:
    displayName: Difficulty
  note.status:
    displayName: Status
  note.topic:
    displayName: Topic
  note.tags:
    displayName: Tags
  note.solved:
    displayName: Times Solved
  note.link:
    displayName: Link
  note.last_solved:
    displayName: Last Solved
views:
  - type: table
    name: All Problems
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - difficulty
      - topic
      - tags
      - solved
      - last_solved
      - link
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Re-solve Queue
    filters:
      and:
        - status == "Cheated"
    order:
      - file.name
      - difficulty
      - topic
      - last_solved
      - link
  - type: table
    name: Not Started
    filters:
      and:
        - status == "Not started"
    order:
      - file.name
      - difficulty
      - topic
  - type: table
    name: Solved (mastery)
    filters:
      and:
        - status == "Solved"
    order:
      - file.name
      - difficulty
      - topic
      - solved
      - last_solved
    summaries:
      solved: Sum
  - type: table
    name: NeetCode 150
    filters:
      and:
        - tags.contains("neetcode-150")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - difficulty
      - topic
      - tags
      - last_solved
      - link
  - type: table
    name: Grokking Patterns
    filters:
      and:
        - tags.contains("grokking-patterns")
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - difficulty
      - topic
      - tags
      - last_solved
      - link
