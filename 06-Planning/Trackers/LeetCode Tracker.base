filters:
  and:
    - file.inFolder("06-Planning/Trackers/LeetCode-Log")
    - file.name != "README"
properties:
  file.name:
    displayName: Problem
  note.difficulty:
    displayName: Difficulty
  note.status:
    displayName: Status
  note.topic:
    displayName: Topic
  note.solved:
    displayName: Times Solved
  note.link:
    displayName: Link
  note.last_solved:
    displayName: Last Solved
views:
  - type: table
    name: All Problems
    order:
      - file.name
      - difficulty
      - topic
      - solved
      - last_solved
      - link
  - type: table
    name: Re-solve Queue
    filters:
      and:
        - status == "Cheated"
    order:
      - file.name
      - difficulty
      - topic
      - last_solved
      - link
  - type: table
    name: Not Started
    filters:
      and:
        - status == "Not started"
    order:
      - file.name
      - difficulty
      - topic
  - type: table
    name: Solved (mastery)
    filters:
      and:
        - status == "Solved"
    order:
      - file.name
      - difficulty
      - topic
      - solved
      - last_solved
    summaries:
      solved: Sum
